<?php
// Database connection
$conn = new mysqli("localhost", "username", "password", "database");

if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

// Fetch filters from the form
$stage = $_GET['stage'] ?? 'all';
$location = $_GET['location'] ?? 'all';
$sector = $_GET['sector'] ?? 'all';
$portfolio = $_GET['portfolio'] ?? 'all';

// Base query
$sql = "SELECT * FROM databaseinfo WHERE 1=1"; // The ⁠ 1=1 ⁠ simplifies adding conditions
$params = [];
$types = "";

// Add filters to the query
if ($stage !== 'all') {
    $sql .= " AND stage = ?";
    $params[] = $stage;
    $types .= "s"; // String type
}

if ($location !== 'all') {
    $sql .= " AND location = ?";
    $params[] = $location;
    $types .= "s";
}

if ($sector !== 'all') {
    $sql .= " AND sector = ?";
    $params[] = $sector;
    $types .= "s";
}

if ($portfolio !== 'all') {
    $sql .= " AND civiclabs_portfolio = ?";
    $params[] = $portfolio;
    $types .= "s";
}

// Prepare and execute the query
$stmt = $conn->prepare($sql);

if ($types) {
    $stmt->bind_param($types, ...$params); // Bind parameters dynamically
}

$stmt->execute();
$result = $stmt->get_result();

?>
