<?php
// Connect to the database
$conn = new mysqli("localhost", "3306", "your_password", "fbbkwkmy_Startups"); //nose si es 33036 o el username de bluehost 
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

// Get filters from the request
$stage = $_GET['stage'] ?? 'all';
$location = $_GET['location'] ?? 'all';

// Build the SQL query
$sql = "SELECT * FROM databaseinfo WHERE 1=1"; //databaseinfo is the name of the table
if ($stage !== 'all') {
    $sql .= " AND stage='$stage'";
}
if ($location !== 'all') {
    $sql .= " AND location='$location'";
}

$result = $conn->query($sql);

$data = [];
if ($result->num_rows > 0) {
    while ($row = $result->fetch_assoc()) {
        $data[] = $row;
    }
}

// Return JSON response
header('Content-Type: application/json');
echo json_encode($data);

$conn->close();
?>
